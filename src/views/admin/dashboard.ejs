<div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">Bảng Điều Khiển Quản Trị</h1>
    <p style="color: var(--text-muted); font-size: 1rem;">Chào mừng Thầy/Cô! Hãy chọn trò chơi và bắt đầu phiên thi đấu cho lớp học.</p>
  </div>
  <div style="display: flex; gap: 12px;">
    <a href="/admin/questions/import" class="btn-gameshow btn-secondary">
      <i class="bi bi-upload"></i> Import Câu Hỏi
    </a>
    <a href="/admin/sessions/create" class="btn-gameshow btn-gold" style="font-size: 1.05rem; padding: 12px 24px;">
      <i class="bi bi-play-circle-fill"></i> TẠO PHIÊN CHƠI MỚI
    </a>
  </div>
</div>

<!-- Stats Row -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 35px;">
  <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
    <div style="width: 60px; height: 60px; border-radius: 14px; background: rgba(0, 242, 254, 0.15); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--accent-cyan);">
      <i class="bi bi-collection-fill"></i>
    </div>
    <div>
      <div style="font-size: 0.9rem; color: var(--text-muted); font-weight: 600;">TỔNG BỘ CÂU HỎI</div>
      <div style="font-size: 2.2rem; font-weight: 800; color: #fff;"><%= stats.totalSets %></div>
    </div>
  </div>

  <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
    <div style="width: 60px; height: 60px; border-radius: 14px; background: rgba(121, 40, 202, 0.15); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--accent-purple);">
      <i class="bi bi-question-diamond-fill"></i>
    </div>
    <div>
      <div style="font-size: 0.9rem; color: var(--text-muted); font-weight: 600;">TỔNG SỐ CÂU HỎI</div>
      <div style="font-size: 2.2rem; font-weight: 800; color: #fff;"><%= stats.totalQuestions %></div>
    </div>
  </div>

  <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
    <div style="width: 60px; height: 60px; border-radius: 14px; background: rgba(255, 215, 0, 0.15); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--accent-gold);">
      <i class="bi bi-broadcast"></i>
    </div>
    <div>
      <div style="font-size: 0.9rem; color: var(--text-muted); font-weight: 600;">PHIÊN ĐANG MỞ</div>
      <div style="font-size: 2.2rem; font-weight: 800; color: var(--accent-gold);"><%= stats.activeSessions %></div>
    </div>
  </div>
</div>

<!-- 6 Game Types Showcase -->
<h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
  <i class="bi bi-joystick" style="color: var(--accent-cyan);"></i> Danh Sách 6 Trò Chơi Học Tập
</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 24px; margin-bottom: 40px;">
  <% gameTypes.forEach(gt => { %>
    <div class="glass-panel" style="padding: 24px; display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid <%= gt.color %>;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff;"><%= gt.name %></h3>
          <div style="width: 44px; height: 44px; border-radius: 10px; background: <%= gt.color %>22; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: <%= gt.color %>;">
            <i class="bi <%= gt.icon %>"></i>
          </div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 20px; line-height: 1.5;">
          <%= gt.description %>
        </p>
      </div>

      <div style="display: flex; gap: 10px;">
        <a href="/admin/sessions/create?game=<%= gt.code %>" class="btn-gameshow btn-primary" style="flex: 1; padding: 9px;">
          <i class="bi bi-play-fill"></i> Tạo Phiên
        </a>
        <a href="/admin/question-sets?game_type=<%= gt.code %>" class="btn-gameshow btn-secondary" style="padding: 9px 14px;" title="Xem bộ câu hỏi">
          <i class="bi bi-folder2-open"></i> Bộ Câu Hỏi
        </a>
      </div>
    </div>
  <% }) %>
</div>

<!-- Recent Sessions -->
<% if (recentSessions && recentSessions.length > 0) { %>
  <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
    <i class="bi bi-clock-history" style="color: var(--accent-gold);"></i> Các Phiên Chơi Gần Đây
  </h2>

  <div class="glass-panel" style="overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background: rgba(255, 255, 255, 0.04); border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;">
          <th style="padding: 14px 20px;">Mã Phòng</th>
          <th style="padding: 14px 20px;">Trò Chơi</th>
          <th style="padding: 14px 20px;">Bộ Câu Hỏi</th>
          <th style="padding: 14px 20px;">Số Đội</th>
          <th style="padding: 14px 20px;">Trạng Thái</th>
          <th style="padding: 14px 20px; text-align: right;">Thao Tác</th>
        </tr>
      </thead>
      <tbody>
        <% recentSessions.forEach(s => { %>
          <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <td style="padding: 16px 20px; font-weight: 800; color: var(--accent-gold); font-size: 1.1rem; letter-spacing: 1px;">
              <%= s.session_code %>
            </td>
            <td style="padding: 16px 20px; font-weight: 600;">
              <% const matchedGt = gameTypes.find(g => g.code === s.game_type_code); %>
              <span class="badge badge-cyan"><%= matchedGt ? matchedGt.name : s.game_type_code %></span>
            </td>
            <td style="padding: 16px 20px; color: var(--text-muted);">
              <%= s.question_set_id ? s.question_set_id.name : 'Chưa gắn' %>
            </td>
            <td style="padding: 16px 20px;"><%= s.teams ? s.teams.length : 0 %> đội</td>
            <td style="padding: 16px 20px;">
              <% if (s.status === 'playing') { %>
                <span class="badge badge-green"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Đang chơi</span>
              <% } else if (s.status === 'ended') { %>
                <span class="badge" style="background: rgba(148, 163, 184, 0.2); color: #94a3b8;">Đã kết thúc</span>
              <% } else { %>
                <span class="badge badge-gold">Đang chờ</span>
              <% } %>
            </td>
            <td style="padding: 16px 20px; text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
              <a href="/admin/sessions/<%= s._id %>/controller" class="btn-gameshow btn-primary" style="padding: 6px 12px; font-size: 0.85rem;">
                <i class="bi bi-sliders"></i> Điều Khiển
              </a>
              <a href="/display/<%= s.session_code %>" target="_blank" class="btn-gameshow btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" title="Mở màn hình máy chiếu">
                <i class="bi bi-tv"></i> Trình Chiếu
              </a>
              <a href="/admin/sessions/<%= s._id %>/summary" class="btn-gameshow btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" title="Xem tổng kết">
                <i class="bi bi-trophy"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
